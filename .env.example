# Copy to .env, enter your key, and restart the server. Never commit .env.
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=data
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.35
LLM_TIMEOUT=60
MAX_UPLOAD_MB=10
